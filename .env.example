# ====================================================================
# Lighthouse TaskFlow v2.1 — Environment Variables Configuration Template
# ====================================================================
# INSTRUCTIONS FOR DEPLOYMENT:
# 1. Copy this file to `.env.local` in the project root.
# 2. Supply active credentials for your server environment.
# 3. Never commit `.env.local` to version control.
# ====================================================================

# [1] Google Gemini AI API Key (Server-side translation & AI executive briefing)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# [2] LINE Official Account Messaging API (Server-side push notifications)
# Obtain at: https://developers.line.biz/
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# [3] Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [4] Supabase PostgreSQL Database (Multi-Tenant RLS Integration)
# Obtain at: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
