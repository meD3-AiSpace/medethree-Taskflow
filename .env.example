# ====================================================================
# TaskFlow Manager — Environment Variables Configuration
# ====================================================================

# Supabase Configuration (Dedicated project for TaskFlow Manager)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Base URL (For LINE Webhook callbacks & Invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LINE Messaging API Configuration (Section 3.4)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
